# DeepSeek API Key (Required for live LLM mode, can be omitted if running with --mock)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generator Model Variant: deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Tavily Search API Key (Optional: DuckDuckGo is used as default free fallback)
TAVILY_API_KEY=

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Engine Settings
MAX_RETRIES=2
MOCK_MODE=false
